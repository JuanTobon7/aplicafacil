# Copiar a infra/.env y ajustar (dev-up.ps1 lo hace solo y genera las llaves vacías).
# infra/.env NO se versiona. Los valores de BD coinciden con los defaults de
# services/backend/config-repo, así los servicios corren desde el IDE sin exportar variables.

# ── Postgres (publicado solo en 127.0.0.1) ───────────────
POSTGRES_PORT=5434
POSTGRES_DB=aplicafacil
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Un usuario y un schema por servicio (infra/postgres/init)
IDENTITY_DB_PASSWORD=identity_svc
LINKEDIN_DB_PASSWORD=linkedin_svc
COMPUTRABAJO_DB_PASSWORD=computrabajo_svc
PROFILE_DB_PASSWORD=profile_svc
JOBS_DB_PASSWORD=jobs_svc
AICONFIG_DB_PASSWORD=aiconfig_svc

# ── Cifrado de la sesión de LinkedIn y de los tokens ─────
# AES-256-GCM: Base64 de exactamente 32 bytes. Sin ella identity-service y
# linkedin-service NO arrancan. Generarla con uno de:
#   openssl rand -base64 32
#   powershell -c "[Convert]::ToBase64String((1..32|%{[byte](Get-Random -Max 256)}))"
# Cambiarla invalida las sesiones guardadas (se marcan EXPIRED y hay que reconectar).
SESSION_ENCRYPTION_KEY=
SESSION_ENCRYPTION_KEY_VERSION=1

# ── Tokens entre servicios ───────────────────────────────
# Secreto con el que linkedin-service (y luego profile/jobs/automation) piden su token de servicio
# a identity-service. dev-up.ps1 lo genera si está vacío.
SERVICE_CLIENT_SECRET=

# ── OAuth 2.0 de LinkedIn (fase desplegada; apagado por defecto) ──
LINKEDIN_OAUTH_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_USER=aplicafacil
RABBITMQ_PASSWORD=aplicafacil

# ── pgAdmin (docker compose --profile tools) ─────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ── LLM (OpenAI o compatible: OpenRouter, etc.) ─────────
# Solo para jobs-/automation-service (Spring AI). Las keys de cada usuario NO van aquí:
# se cargan desde la página /ia y se guardan cifradas en ai-config-service (ADR 0005).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# ── mcp-gateway (Python, ADR 0005) ───────────────────────
# Sin config-server: el mcp-gateway lee estas variables. Ver services/mcp-gateway/.env.example
MCP_PORT=8000
MCP_CREDENTIAL_TTL_SECONDS=3600
MCP_RECONCILE_INTERVAL_SECONDS=300
