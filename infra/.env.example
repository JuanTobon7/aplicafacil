# Copiar a infra/.env y ajustar. SOLO para desarrollo local.
# Los valores de BD coinciden con los defaults de services/backend/config-repo,
# así los servicios corren desde el IDE sin exportar variables.

# ── Postgres ─────────────────────────────────────────────
POSTGRES_DB=aplicafacil
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PEOPLE_DB_PASSWORD=people_svc
PROFILE_DB_PASSWORD=profile_svc
JOBS_DB_PASSWORD=jobs_svc
AUTH_DB_PASSWORD=auth_svc

# ── auth-service (OAuth 2.1 / OIDC) ──────────────────────
# Admin inicial: se crea al arrancar si no existe. La contraseña debe tener
# 8+ caracteres con letras y números.
AUTH_ADMIN_EMAIL=admin@aplicafacil.local
AUTH_ADMIN_PASSWORD=CambiaEsto123
# Secretos de los clientes OAuth confidenciales
AUTOMATION_CLIENT_SECRET=change-me-automation
MCP_GATEWAY_CLIENT_SECRET=change-me-mcp

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_USER=aplicafacil
RABBITMQ_PASSWORD=aplicafacil

# ── LLM (OpenAI o compatible: OpenRouter, etc.) ─────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
