{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "eslint/max-lines-per-function": [
      "warn",
      {
        "max": 40,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "eslint/complexity": [
      "warn",
      {
        "max": 10
      }
    ],
    "eslint/max-params": [
      "warn",
      {
        "max": 4
      }
    ],
    "eslint/max-depth": [
      "warn",
      {
        "max": 3
      }
    ],
    "eslint/max-lines": [
      "warn",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "eslint/max-nested-callbacks": [
      "warn",
      {
        "max": 3
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**"
  ]
}
