# mcp-gateway: solo placeholders. En local dev-up.ps1 toma los valores de infra/.env.
# NUNCA se configuran aquí API keys de proveedores: cada usuario las carga en /ia y viven cifradas en ai-config-service.

# ── Servidor ───────────────────────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8000
# URL pública de /mcp (identificador del recurso, RFC 9728)
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp
# Protección contra DNS rebinding (Host/Origin permitidos)
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# MCP_INSTANCE_ID=           # por defecto host:pid:aleatorio

# ── Identidad (JWT de identity-service) ────────────────────
AUTH_ISSUER_URI=http://127.0.0.1:9000
AUTH_JWKS_URI=http://127.0.0.1:9000/.well-known/jwks.json
AUTH_AUDIENCE=aplicafacil-api
IDENTITY_SERVICE_URL=http://127.0.0.1:9000
SERVICE_CLIENT_ID=mcp-gateway
SERVICE_CLIENT_SECRET=<mismo valor que infra/.env>

# ── Backend ────────────────────────────────────────────────
# http://… directo o lb://ai-config-service (resuelto con Eureka)
AI_CONFIG_SERVICE_URL=http://127.0.0.1:8086

# ── RabbitMQ ───────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=aplicafacil
RABBITMQ_PASSWORD=<placeholder>
MCP_MESSAGING_ENABLED=true

# ── Eureka (fase desplegada; en local apagado como los servicios Java) ──
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_APP_NAME=mcp-gateway
EUREKA_PREFER_IP_ADDRESS=true
EUREKA_INSTANCE_IP=127.0.0.1
# EUREKA_INSTANCE_HOSTNAME=mcp-gateway

# ── Proveedores y resiliencia ──────────────────────────────
# Adaptadores extra o reemplazos: TIPO=modulo:Clase,OTRO=modulo:Clase
# MCP_PROVIDER_ADAPTERS=OLLAMA=mi_paquete.ollama:OllamaProviderAdapter
MCP_CREDENTIAL_TTL_SECONDS=3600
MCP_RECONCILE_INTERVAL_SECONDS=300
MCP_GENERATION_TIMEOUT_SECONDS=90
MCP_CONNECT_TIMEOUT_SECONDS=5
MCP_REQUEST_TIMEOUT_SECONDS=60
MCP_PROVIDER_MAX_CONCURRENCY=4
MCP_PROVIDER_RATE_PER_MINUTE=60
MCP_RETRY_MAX_ATTEMPTS=3
MCP_RETRY_GENERATION=false
MCP_BREAKER_FAILURE_THRESHOLD=5
MCP_BREAKER_RESET_SECONDS=30

# ── Logs ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
