{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aplicafacil.local/schemas/ai-provider-status-event.schema.json",
  "title": "ai.provider.*",
  "description": "El mcp-gateway lo publica en aplicafacil.events con routing key ai.provider.<initialization-started|initialization-succeeded|initialization-failed|test-completed>. ai-config-service lo aplica solo si configVersion es la versión vigente. errorMessage ya viene saneado (sin claves ni headers).",
  "type": "object",
  "required": ["schemaVersion", "eventId", "eventType", "configId", "userId", "configVersion", "status", "correlationId", "occurredAt", "instanceId"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": {
      "enum": [
        "ai.provider.initialization-started",
        "ai.provider.initialization-succeeded",
        "ai.provider.initialization-failed",
        "ai.provider.test-completed"
      ]
    },
    "configId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "configVersion": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["INITIALIZING", "ACTIVE", "FAILED"] },
    "errorCode": { "type": ["string", "null"], "maxLength": 64 },
    "errorMessage": { "type": ["string", "null"], "maxLength": 500 },
    "models": {
      "type": ["array", "null"],
      "maxItems": 500,
      "items": { "type": "string", "maxLength": 200 }
    },
    "latencyMs": { "type": ["integer", "null"], "minimum": 0 },
    "correlationId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "instanceId": { "type": "string", "maxLength": 200 }
  }
}
